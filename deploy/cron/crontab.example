# ai-betting ingestion — host crontab entries (installed under the `ubuntu` user).
# Driver: deploy/cron/ingest.sh. Uses flock so a slow run never overlaps the next
# tick. Times are in the host timezone (UTC). Logs append to ~/logs/ai-betting-ingest.log.
#
# Install:  ( crontab -l 2>/dev/null; cat deploy/cron/crontab.example ) | crontab -
# Inspect:  crontab -l        Tail logs:  tail -f ~/logs/ai-betting-ingest.log

# Daily 06:15 UTC — sync fixtures/results, rebuild features, map upcoming odds fixtures
15 6 * * *  /usr/bin/flock -n /tmp/ai-betting-daily.lock /home/ubuntu/ai-betting/deploy/cron/ingest.sh daily >> /home/ubuntu/logs/ai-betting-ingest.log 2>&1

# Every 3 hours (:05) — snapshot current 1X2 odds for the Greek Super League
5 */3 * * * /usr/bin/flock -n /tmp/ai-betting-odds.lock /home/ubuntu/ai-betting/deploy/cron/ingest.sh odds >> /home/ubuntu/logs/ai-betting-ingest.log 2>&1
